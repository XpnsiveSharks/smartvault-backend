# --- Docker Services (Safe Defaults) ---
# These point to the internal Docker containers. 
# No need to change these if running via Docker Compose.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/smartvault
REDIS_URL=redis://redis:6379/0

# --- App Settings ---
APP_ENV=development
DEBUG=true

# --- Secrets (REQUIRED) ---
# You must set these yourself.
# Run: openssl rand -hex 32
SECRET_KEY=super-secret-key-that-you-should-change-me
API_KEY=

# --- Internal surface credentials (hashed) ---
# echo -n "your-ops-token" | sha256sum
INTERNAL_OPS_TOKEN_HASH=
INTERNAL_OPS_TOKEN_ID=ops-shared

# For admin, prefer JWT (set ADMIN_JWT_SECRET) or a shared token hash.
ADMIN_JWT_SECRET=
ADMIN_SHARED_TOKEN_HASH=
ADMIN_TOKEN_ID=admin-shared
